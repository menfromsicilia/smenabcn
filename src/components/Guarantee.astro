---
import Icon from './ui/Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  title: string;
  text: string;
  icon: IconName;
  index: number;
}

const { title, text, icon, index } = Astro.props;
---

<div class="guarantee" data-reveal style={`--i: ${index}`}>
  <span class="icon"><Icon name={icon} size={26} /></span>
  <div>
    <h3 class="h3">{title}</h3>
    <p>{text}</p>
  </div>
</div>

<style>
  .guarantee {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--butter);
    color: var(--ink);
  }

  .icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--butter);
  }

  .h3 {
    margin-bottom: 6px;
  }

  p {
    font-size: 15px;
  }

  @media (min-width: 1024px) {
    .guarantee {
      padding: 32px;
    }

    p {
      font-size: 17px;
    }
  }
</style>
