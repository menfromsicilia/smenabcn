---
import Icon from './ui/Icon.astro';
import Photo from './ui/Photo.astro';
import Sticker from './Sticker.astro';
import { accent, useTranslations, type Lang } from '../i18n/utils';
import type { IconName } from '../lib/icons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const factIcons: IconName[] = ['clock', 'refresh', 'euro'];
---

<section id="top" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container-x grid">
    <div class="copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="h1" set:html={accent(t.hero.title)} />
      <p class="lead">{t.hero.subtitle}</p>
      <div class="ctas">
        <a class="btn" href="#form" data-intent="business" data-event="cta_hero_business">
          {t.hero.ctaPrimary}
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn-secondary" href="#candidate" data-intent="candidate" data-event="cta_hero_candidate">
          {t.hero.ctaSecondary}
        </a>
      </div>
      <ul class="facts">
        {t.hero.facts.map((fact, index) => (
          <li>
            <span class="fact-icon"><Icon name={factIcons[index]!} size={20} /></span>
            <span><strong>{fact.value}</strong> — {fact.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="collage">
      <figure class="card card-a">
        <Photo photo="barista" alt={t.hero.photos.barista} icon="coffee" tone="butter" eager sizes="(min-width: 1024px) 22vw, 46vw" />
      </figure>
      <figure class="card card-b">
        <Photo photo="waiter" alt={t.hero.photos.waiter} icon="utensils" tone="tomato" eager sizes="(min-width: 1024px) 20vw, 46vw" />
      </figure>
      <figure class="card card-c">
        <Photo photo="beauty" alt={t.hero.photos.beauty} icon="sparkles" tone="blush" sizes="(min-width: 1024px) 18vw, 40vw" />
      </figure>
      <Sticker text={t.hero.sticker} class="hero-sticker" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 24px 0 64px;
  }

  .grid {
    display: grid;
    gap: 48px;
  }

  .copy {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .h1 {
    --accent: var(--tomato-ink);
  }

  .ctas {
    display: grid;
    gap: 12px;
    margin-top: 6px;
  }

  .facts {
    display: grid;
    gap: 10px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fact-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--sky);
    box-shadow: 0 1px 0 var(--line);
  }

  .collage {
    position: relative;
    height: 380px;
    max-width: 520px;
    width: 100%;
    margin-inline: auto;
  }

  .card {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 18px 40px -18px rgb(28 26 23 / .35);
  }

  .card-a {
    left: 0;
    top: 20px;
    width: 56%;
    height: 300px;
    transform: rotate(-3deg);
  }

  .card-b {
    right: 0;
    top: 60px;
    width: 52%;
    height: 280px;
    transform: rotate(3.5deg);
  }

  .card-c {
    display: none;
  }

  .collage :global(.hero-sticker) {
    position: absolute;
    left: 42%;
    top: -6px;
    z-index: 2;
    width: 96px;
    height: 96px;
  }

  @media (min-width: 560px) {
    .ctas {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 768px) {
    .facts {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 28px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 48px 0 104px;
    }

    .grid {
      grid-template-columns: 7fr 5fr;
      gap: 24px;
      align-items: center;
    }

    .copy {
      gap: 28px;
      padding-right: 24px;
    }

    .collage {
      height: 600px;
      max-width: none;
    }

    .card-a {
      top: 0;
      left: 4%;
      width: 58%;
      height: 360px;
    }

    .card-b {
      top: 220px;
      right: 0;
      width: 52%;
      height: 340px;
    }

    .card-c {
      display: block;
      left: 0;
      bottom: 0;
      width: 40%;
      height: 220px;
      transform: rotate(-2deg);
      z-index: 1;
    }

    .collage :global(.hero-sticker) {
      left: auto;
      right: 6%;
      top: 80px;
      width: 110px;
      height: 110px;
    }
  }
</style>
