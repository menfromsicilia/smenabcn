---
interface Props {
  items: string[];
}

const { items } = Astro.props;
const row = items.map((item) => item.toLocaleUpperCase());
---

<div class="marquee" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => (
      <div class="group">
        {row.map((item) => (
          <span class="item">{item}<span class="star">✦</span></span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    display: flex;
    align-items: center;
    height: 64px;
    overflow: hidden;
    background: var(--ink);
    color: var(--bg);
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 36s linear infinite;
  }

  .group {
    display: flex;
    flex: none;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .star {
    color: var(--sky);
    font-size: 18px;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
