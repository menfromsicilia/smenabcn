---
import Icon from './ui/Icon.astro';
import Photo from './ui/Photo.astro';
import type { RoleKey, PhotoKey } from '../content/site';
import type { IconName } from '../lib/icons';

interface Props {
  role: RoleKey;
  index: number;
  title: string;
  roles: string[];
  cta: string;
  ctaAria: string;
  color: string;
}

const { role, index, title, roles, cta, ctaAria, color } = Astro.props;
const visuals: Record<RoleKey, { photo: PhotoKey; icon: IconName; tone: 'tomato' | 'butter' | 'blush' | 'sky' | 'ink' }> = {
  floor: { photo: 'waiter', icon: 'wine', tone: 'butter' },
  coffee: { photo: 'barista', icon: 'coffee', tone: 'tomato' },
  front: { photo: 'reception', icon: 'bell', tone: 'sky' },
  beauty: { photo: 'beauty', icon: 'scissors', tone: 'butter' },
};
const visual = visuals[role];
const titleId = `role-${role}`;
---

<article class:list={['role-card', `color-${color}`]} aria-labelledby={titleId} data-reveal style={`--i: ${index}`}>
  <div class="top">
    <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <div class="thumb">
      <Photo photo={visual.photo} alt="" icon={visual.icon} tone={visual.tone} widths={[96, 192]} sizes="96px" />
    </div>
  </div>
  <h3 id={titleId} class="h3">{title}</h3>
  <p class="list">{roles.join(' · ')}</p>
  <a
    class="link-arrow"
    href="#form"
    data-intent="business"
    data-role={role}
    data-event="card_role_click"
    data-event-role={role}
    aria-label={ctaAria.replace('{role}', title)}
  >
    {cta}
    <Icon name="arrow-right" />
  </a>
</article>

<style>
  .role-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 100%;
    padding: 28px;
    border-radius: var(--radius-lg);
    color: var(--ink);
  }

  .color-tomato { background: var(--tomato); }
  .color-butter { background: var(--butter); }
  .color-blush { background: var(--blush); }
  .color-surface { background: var(--surface); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .color-surface .num { color: var(--sky); }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
  }

  .num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 64px;
    line-height: .9;
    letter-spacing: -0.04em;
  }

  .thumb {
    width: 96px;
    height: 96px;
    flex: none;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgb(255 255 255 / .5);
  }

  .thumb :global(.placeholder svg) {
    width: 40%;
  }

  .list {
    font-size: 15px;
    line-height: 1.6;
  }

  .link-arrow {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (min-width: 1024px) {
    .role-card {
      gap: 16px;
      padding: 36px;
    }

    .num {
      font-size: 88px;
    }

    .list {
      font-size: 17px;
    }
  }
</style>
