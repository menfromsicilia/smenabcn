---
import Landing from '../../components/Landing.astro';
import { langCodes, defaultLang, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return langCodes.filter((lang) => lang !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Landing lang={lang} />
